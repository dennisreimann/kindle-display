# Server port
DISPLAY_SERVER_PORT=3030

# SOCKS5 proxy address (host:port) for routing external API calls through
# Tor or another SOCKS5 proxy. When unset, curl connects directly.
# Local services (Bitcoin RPC, local Mempool) are always reached directly.
# DISPLAY_SOCKS_PROXY="127.0.0.1:9050"

# Require a SOCKS5 proxy for external API calls.
# When true, data.sh exits with an error if DISPLAY_SOCKS_PROXY is not set.
DISPLAY_FORCE_TOR=false

# Bitcoin RPC settings for getting the blockcount.
# Omit these settings to use blockchain.info as a fallback.
# BITCOIN_RPC_ADDR="127.0.0.1:8332"
# DISPLAY_BITCOIN_RPC_USER="bitcoin-rpc-user"
# DISPLAY_BITCOIN_RPC_PASS="bitcoin-rpc-password"

# Use blockchain.info as a fallback when Bitcoin RPC is not available.
DISPLAY_FALLBACK_BLOCK=true

# Local Mempool instance address (host:port) to use instead of mempool.space
# for fees, mempool blocks, Lightning statistics, and exchange rates.
# When set, these calls go directly (no proxy). When unset, the public
# mempool.space is used (proxied if DISPLAY_SOCKS_PROXY is set).
# MEMPOOL_API_ADDR="127.0.0.1:8080"

# Exchange rates to show.
# Supported currencies: USD, EUR, GBP, CHF, CAD, AUD, JPY
DISPLAY_RATE1="USD"
DISPLAY_RATE2="EUR"

# Display settings: quote (default), fees, lightning, stats, random
DISPLAY_THEME="quote"
