if lightning && lightning.latest
  .stats
    +displayStat(sats2BTC(lightning.latest.total_capacity), 'BTC capacity', lightning.previous ? sats2BTC(lightning.latest.total_capacity - lightning.previous.total_capacity) : null)
    +displayStat(num(lightning.latest.node_count), 'nodes', lightning.previous ? num(lightning.latest.node_count - lightning.previous.node_count) : null)
    +displayStat(num(lightning.latest.channel_count), 'channels', lightning.previous ? num(lightning.latest.channel_count - lightning.previous.channel_count) : null)
