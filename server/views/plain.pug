extends _layout

block content
  main
    .top
      if rates && rates[0]
        h2.value-type.price--rate1: +displayRate(rates[0])
      include _blockheight
      if rates && rates[1] && (!displayQuote || quote && quote.body.length < 115)
        h2.value-type.price--rate2: +displayRate(rates[1])
  include _quote
  .bg.bg--sat
